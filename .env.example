# Run `claude setup-token` and paste the result (uses your Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=
PROJECTS_ROOT=C:\Users\you\Projects
# docker (default) runs agents in containers on this PC. cloud runs each task as a claude.ai cloud session,
# listed in the Claude app's Code tab; it needs `claude auth login` on this PC (the token above isn't enough).
AGENT_MODE=docker
# Cloud mode only, when claude.exe isn't on PATH: its full path (not npm's claude.cmd).
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
# Docker agents, optional: stop a turn once its estimated cost passes this many dollars.
# AGENT_MAX_USD=5
# Optional: the model for quick photo answers (default claude-haiku-5-5, the fastest).
# QUICK_LOOK_MODEL=claude-haiku-5-5
# Cloud mode only, optional: a claude.ai project routine's API trigger (URL and token from the routine's
# API trigger), started after each finished task so the task is recorded as a thread in that project.
# BRIDGE_ROUTINE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_.../fire
# BRIDGE_ROUTINE_TOKEN=
HOOK_PORT=47878
# Optional: phone notifications through ntfy. Everything Bridge says is also posted to this topic, so it
# reaches the phone when the app isn't open. On ntfy.sh anyone who knows the topic can read it: make it long
# and random, and subscribe to it in the ntfy app. NTFY_TOKEN is only for a server that needs sign-in.
# NTFY_URL=https://ntfy.sh/bridge-<at least 20 random letters and digits>
# NTFY_TOKEN=
# Optional: error reports to Sentry (sentry.mjs): the DSN from your Sentry project's Client Keys page. A report
# is the error's type, the start of its message with addresses, paths and tokens taken out, and where it happened.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Bearer token for the Bridge app and the iPhone Shortcut (a random string of at least 24 characters). Required.
VOICE_TOKEN=
VOICE_PORT=47879
# 1 (default) reads tasks back and waits for "send it"; 0 sends immediately
VOICE_CONFIRM=1

# Optional: natural voice in the glasses app (cloud text-to-speech). Without a key it uses the iPhone voice.
OPENAI_API_KEY=
# TTS_VOICE=coral
# TTS_MODEL=gpt-4o-mini-tts

# GitHub access for agents: run `node setup-github-app.mjs`, which fills these in.
# Agents never see a token: the relay pushes their branches with one for that repo only, revoked after. The key file stays outside the repo.
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=
# Or, instead of the App: a fine-grained token (only the agents' repos; Contents + Pull requests read/write).
# AGENT_GH_TOKEN=
