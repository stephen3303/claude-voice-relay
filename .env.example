# Run `claude setup-token` and paste the result (uses your Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=
PROJECTS_ROOT=C:\Users\steph\Projects
HOOK_PORT=47878

# Bearer token for the Bridge app and the iPhone Shortcut (any long random string). Required.
VOICE_TOKEN=
VOICE_PORT=47879
# 1 (default) reads tasks back and waits for "send it"; 0 sends immediately
VOICE_CONFIRM=1

# Optional: natural voice in the glasses app (cloud text-to-speech). Without a key it uses the iPhone voice.
OPENAI_API_KEY=
# TTS_VOICE=coral
# TTS_MODEL=gpt-4o-mini-tts
