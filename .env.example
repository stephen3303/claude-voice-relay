# Run `claude setup-token` and paste the result (uses your Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=
PROJECTS_ROOT=C:\Users\steph\Projects
HOOK_PORT=47878

# Bearer token for the Bridge app and the iPhone Shortcut (a random string of at least 24 characters). Required.
VOICE_TOKEN=
VOICE_PORT=47879
# 1 (default) reads tasks back and waits for "send it"; 0 sends immediately
VOICE_CONFIRM=1

# Optional: natural voice in the glasses app (cloud text-to-speech). Without a key it uses the iPhone voice.
OPENAI_API_KEY=
# TTS_VOICE=coral
# TTS_MODEL=gpt-4o-mini-tts

# Optional: phone alerts through the free ntfy app (https://ntfy.sh) when Bridge isn't open. Install ntfy on the iPhone and
# subscribe to this topic. The topic is the secret, so make it long and random (8-64 letters, digits, - or _).
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# GitHub access for agents: run `node setup-github-app.mjs`, which fills these in.
# Agents never see a token: the relay pushes their branches with one for that repo only, revoked after. The key file stays outside the repo.
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=
# Or, instead of the App: a fine-grained token (only the agents' repos; Contents + Pull requests read/write).
# AGENT_GH_TOKEN=
